. ./common/config

_log_dmesg()
{
	if [ -w /dev/kmsg ]; then
		echo -e "$@" >/dev/kmsg
	fi
}

_is_rpm_ostree()
{
	if [ -f /run/ostree-booted ]; then
		return 0
	fi

	return 1
}

_fatal()
{
	echo "$*"
	exit 1
}
